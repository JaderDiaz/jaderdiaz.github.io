---
import PlaceholderImage from './PlaceholderImage.astro';

interface Props {
  title: string;
  description: string;
  tech: string;
  tags: 'web' | 'cloud' | 'bots';
  screenshotCaption: string;
}
const { title, description, tech, tags, screenshotCaption } = Astro.props;
---

<article data-reveal data-lift data-tags={tags} class="project-card">
  <PlaceholderImage caption={screenshotCaption} aspectRatio="wide" class="project-card__image" />
  <div class="project-card__body">
    <h3>{title}</h3>
    <p class="project-card__description">{description}</p>
    <p class="project-card__tech mono">{tech}</p>
  </div>
</article>

<style>
  .project-card {
    border: 1px solid var(--line);
    background: var(--card);
    border-radius: 2px;
  }
  .project-card :global(.project-card__image) {
    border: none;
    border-bottom: 1px solid var(--line);
  }
  .project-card__body {
    padding: 22px;
    border-top: 1px solid var(--line2);
  }
  .project-card__description {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }
  .project-card__tech {
    margin: 12px 0 0;
    font-size: 11px;
    color: var(--accent);
  }

  /* Same scroll-linked settle-in as ServiceCard, using standalone
     scale/rotate so it composes with the [data-lift] hover transition
     instead of overriding it. Pure CSS, no JS. */
  @supports (animation-timeline: view()) {
    .project-card {
      animation: project-card-scroll-in linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 60%;
    }
    @media (prefers-reduced-motion: reduce) {
      .project-card { animation: none; }
    }
  }
  @keyframes project-card-scroll-in {
    from { scale: 0.92; rotate: 1deg; }
    to { scale: 1; rotate: 0deg; }
  }
</style>
