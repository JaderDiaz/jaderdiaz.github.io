---
interface Props {
  index: string;
  title: string;
  description: string;
}
const { index, title, description } = Astro.props;
---

<div data-reveal data-lift class="service-card">
  <div class="service-card__index mono">{index}</div>
  <h3>{title}</h3>
  <p class="service-card__description">{description}</p>
</div>

<style>
  .service-card {
    background: var(--bg);
    border: 1px solid var(--line);
    padding: clamp(24px, 3vw, 34px);
    border-radius: 2px;
  }
  .service-card__index {
    font-size: 11px;
    color: var(--faint);
    margin-bottom: 14px;
  }
  .service-card__description {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  /* Scroll-linked scale/settle-in, layered on top of the JS fade reveal and
     the [data-lift] hover effect. Animates the standalone `scale`/`rotate`
     properties (not the `transform` shorthand) specifically so it composes
     with — instead of overriding — the hover-lift's `transform: translateY()`
     transition on the same element. Pure CSS, no JS. */
  @supports (animation-timeline: view()) {
    .service-card {
      animation: service-card-scroll-in linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 60%;
    }
    @media (prefers-reduced-motion: reduce) {
      .service-card { animation: none; }
    }
  }
  @keyframes service-card-scroll-in {
    from { scale: 0.92; rotate: -1deg; }
    to { scale: 1; rotate: 0deg; }
  }
</style>
