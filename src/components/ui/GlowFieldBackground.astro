---
// Soft floating blurred glows — the same technique as the hero's, packaged
// as a reusable background for sections that want a warmer, more organic
// feel than the code-glyph or node-grid variants. Positions/motions are
// fixed classes (CSP-safe); a small script randomly assigns which variant
// each blob gets on every page load, only touching classList. Place inside
// a `position: relative; overflow: hidden;` container; give the real
// content `position: relative; z-index: 1` so it stays above this.
---

<div class="glow-field" data-glow-field aria-hidden="true">
  <span class="glow-field__blob glow-field__blob--a"></span>
  <span class="glow-field__blob glow-field__blob--b"></span>
</div>

<style>
  .glow-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .glow-field__blob {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent) 0%, transparent 70%);
    opacity: 0.2;
    filter: blur(6px);
  }
  .glow-field__blob--a {
    top: -10%;
    left: -8%;
    width: 60%;
    aspect-ratio: 1;
    animation: glow-field-float-a 16s ease-in-out infinite;
  }
  .glow-field__blob--b {
    bottom: -14%;
    right: -10%;
    width: 50%;
    aspect-ratio: 1;
    animation: glow-field-float-b 20s ease-in-out infinite;
  }
  .glow-field__blob--c {
    top: 30%;
    left: 60%;
    width: 40%;
    aspect-ratio: 1;
    animation: glow-field-float-c 18s ease-in-out infinite;
  }
  @keyframes glow-field-float-a {
    0%, 100% { translate: 0 0; scale: 1; }
    50% { translate: 46px 34px; scale: 1.18; }
  }
  @keyframes glow-field-float-b {
    0%, 100% { translate: 0 0; scale: 1; }
    50% { translate: -40px -32px; scale: 1.15; }
  }
  @keyframes glow-field-float-c {
    0%, 100% { translate: 0 0; scale: 1; }
    50% { translate: -30px 40px; scale: 1.2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .glow-field__blob { animation: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-glow-field]').forEach((field) => {
    const variants = ['a', 'b', 'c'];
    for (let i = variants.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [variants[i], variants[j]] = [variants[j], variants[i]];
    }
    const blobs = Array.from(field.querySelectorAll<HTMLElement>('.glow-field__blob'));
    blobs.forEach((blob, i) => {
      blob.classList.remove('glow-field__blob--a', 'glow-field__blob--b', 'glow-field__blob--c');
      blob.classList.add(`glow-field__blob--${variants[i % variants.length]}`);
    });
  });
</script>
