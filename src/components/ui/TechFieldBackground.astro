---
// Decorative floating tech glyphs — pure CSS, no JS, no inline styles
// (each position/timing is a fixed class, same pattern as PlaceholderImage,
// so it stays CSP-safe). Place inside a `position: relative; overflow:
// hidden;` container; give the real content `position: relative; z-index: 1`
// so it stays above this layer.
---

<div class="tech-field" aria-hidden="true">
  <span class="tech-field__item tech-field__item--1 mono">&lt;/&gt;</span>
  <span class="tech-field__item tech-field__item--2 mono">{'{ }'}</span>
  <span class="tech-field__item tech-field__item--3 mono">01</span>
  <span class="tech-field__item tech-field__item--4 mono">$_</span>
  <span class="tech-field__item tech-field__item--5 mono">#!</span>
  <span class="tech-field__item tech-field__item--6 mono">git</span>
</div>

<style>
  .tech-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .tech-field__item {
    position: absolute;
    color: var(--accent);
    opacity: 0.09;
    font-weight: 700;
    animation: tech-field-float linear infinite;
  }
  .tech-field__item--1 { top: 8%;  left: 6%;  font-size: 46px; animation-duration: 24s; animation-delay: -2s; }
  .tech-field__item--2 { top: 64%; left: 10%; font-size: 34px; animation-duration: 29s; animation-delay: -16s; }
  .tech-field__item--3 { top: 18%; left: 86%; font-size: 30px; animation-duration: 21s; animation-delay: -8s; }
  .tech-field__item--4 { top: 72%; left: 80%; font-size: 42px; animation-duration: 33s; animation-delay: -20s; }
  .tech-field__item--5 { top: 42%; left: 48%; font-size: 26px; animation-duration: 27s; animation-delay: -11s; }
  .tech-field__item--6 { top: 10%; left: 44%; font-size: 22px; animation-duration: 19s; animation-delay: -5s; }

  @keyframes tech-field-float {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(14px, -20px) rotate(4deg); }
    50% { transform: translate(-10px, 12px) rotate(-3deg); }
    75% { transform: translate(-16px, -8px) rotate(3deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tech-field__item { animation: none; }
  }
</style>
