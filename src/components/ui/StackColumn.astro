---
interface Props {
  label: string;
  items: string[];
}
const { label, items } = Astro.props;
---

<div data-reveal class="stack-column">
  <div class="stack-column__label mono">{label}</div>
  <div class="stack-column__items">
    {items.map((item) => <span>{item}</span>)}
  </div>
</div>

<style>
  .stack-column__label {
    font-size: 13px;
    font-weight: 700;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ink);
  }
  .stack-column__items {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 14px;
    font-size: 15px;
    color: var(--muted);
  }
</style>
