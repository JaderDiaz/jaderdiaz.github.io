---
interface Props {
  quote: string;
  attribution: string;
  emphasized?: boolean;
}
const { quote, attribution, emphasized = false } = Astro.props;
---

<div data-reveal class:list={['testimonial-item', emphasized && 'testimonial-item--emphasized']}>
  <p class="testimonial-item__quote">{quote}</p>
  <p class="testimonial-item__attribution mono">{attribution}</p>
</div>

<style>
  .testimonial-item {
    border-left: 2px solid var(--line);
    padding: 4px 0 4px 20px;
  }
  .testimonial-item--emphasized {
    border-left-color: var(--accent);
  }
  .testimonial-item__quote {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted);
  }
  .testimonial-item__attribution {
    margin: 10px 0 0;
    font-size: 12px;
    color: var(--faint);
  }
</style>
