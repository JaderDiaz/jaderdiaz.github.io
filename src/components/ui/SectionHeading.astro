---
interface Props {
  eyebrow: string;
  as?: 'div' | 'h2';
  class?: string;
}

const { eyebrow, as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag data-reveal class:list={['section-eyebrow', 'mono', className]}>{eyebrow}</Tag>

<style>
  .section-eyebrow {
    font-size: 12px;
    letter-spacing: .16em;
    color: var(--accent);
    margin-bottom: 34px;
  }
</style>
