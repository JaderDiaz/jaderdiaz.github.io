---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<span class="education-badge mono">{label}</span>

<style>
  .education-badge {
    padding: 8px 14px;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 2px;
    font-size: 12px;
  }
</style>
