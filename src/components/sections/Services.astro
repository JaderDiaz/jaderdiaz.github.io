---
import type { SiteContent } from '../../i18n/content';
import SectionHeading from '../ui/SectionHeading.astro';
import ServiceGrid from './ServiceGrid.astro';
import TechFieldBackground from '../ui/TechFieldBackground.astro';

interface Props {
  services: SiteContent['services'];
}
const { services } = Astro.props;
---

<section id="servicios" class="section services-section">
  <TechFieldBackground />
  <div class="wrap services-section__content">
    <SectionHeading eyebrow={services.eyebrow} />
    <p class="services-intro">{services.intro}</p>
    <ServiceGrid services={services} />
  </div>
</section>

<style>
  .services-section {
    position: relative;
    overflow: hidden;
  }
  .services-section__content {
    position: relative;
    z-index: 1;
  }
  .services-intro {
    max-width: 640px;
    margin: -18px 0 34px;
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.6;
    color: var(--muted);
  }
</style>
