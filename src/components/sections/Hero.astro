---
import type { SiteContent } from '../../i18n/content';
import ProfileCard from './ProfileCard.astro';

interface Props {
  hero: SiteContent['hero'];
}
const { hero } = Astro.props;
---

<section id="top" class="hero" data-hero-glows>
  <div class="hero__glow hero__glow--a" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--b" aria-hidden="true"></div>
  <div class="hero__grid wrap">
    <div>
      <div data-hero-in class="hero__badge mono">
        <span class="hero__badge-dot"></span>
        <span>{hero.availability}</span>
      </div>
      <h1 data-hero-in>{hero.name}</h1>
      <p data-hero-in class="hero__tagline mono">{hero.tagline}</p>
      <p data-hero-in class="hero__description">{hero.description}</p>
      <div data-hero-in class="hero__ctas mono">
        <a href="#contacto" data-cta class="hero__cta hero__cta--primary">{hero.ctaPrimary}</a>
        <a href="#experiencia" data-cta class="hero__cta hero__cta--secondary">{hero.ctaSecondary}</a>
      </div>
    </div>
    <ProfileCard photoLabel={hero.photoLabel} photoCaption={hero.photoCaption} stats={hero.stats} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 80px 80px;
    border-bottom: 1px solid var(--line);
    animation: hero-grid-drift 40s linear infinite;
  }
  @keyframes hero-grid-drift {
    to { background-position: 80px 80px, 80px 80px; }
  }

  /* Soft floating accent glows — decorative only, a hint of motion behind
     the grid so the background doesn't read as flat/static. */
  .hero__glow {
    position: absolute;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent) 0%, transparent 70%);
    opacity: .22;
    filter: blur(6px);
    pointer-events: none;
  }
  .hero__glow--a {
    top: -140px;
    right: -100px;
    width: 560px;
    height: 560px;
    animation: hero-glow-float-a 15s ease-in-out infinite;
  }
  .hero__glow--b {
    bottom: -180px;
    left: -120px;
    width: 480px;
    height: 480px;
    animation: hero-glow-float-b 18s ease-in-out infinite;
  }
  .hero__glow--c {
    top: 20%;
    left: 30%;
    width: 400px;
    height: 400px;
    animation: hero-glow-float-c 20s ease-in-out infinite;
  }
  @keyframes hero-glow-float-a {
    0%, 100% { translate: 0 0; scale: 1; }
    50% { translate: -90px 100px; scale: 1.25; }
  }
  @keyframes hero-glow-float-b {
    0%, 100% { translate: 0 0; scale: 1; }
    50% { translate: 90px -70px; scale: 1.18; }
  }
  @keyframes hero-glow-float-c {
    0%, 100% { translate: 0 0; scale: 1; }
    50% { translate: -50px -60px; scale: 1.2; }
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(32px, 5vw, 56px);
    padding: clamp(48px, 7vw, 80px) clamp(20px, 4vw, 48px);
    align-items: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero,
    .hero__glow {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .hero__grid {
      padding-top: 28px;
      padding-bottom: 36px;
    }
  }
  .hero__badge {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 28px;
  }
  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: blink 2s steps(1) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__badge-dot { animation: none; }
  }
  .hero__tagline {
    margin: 22px 0 0;
    font-size: 15px;
    color: var(--accent);
  }
  /* The typewriter/caret treatment needs white-space: nowrap to reveal
     character-by-character, but at narrower widths (where the hero grid
     has already stacked to one column and this column is much narrower)
     a tagline this long in a monospace font can be wider than the column
     — nowrap would then clip it permanently instead of just "still
     typing". Only apply it once there's realistically enough room. */
  @media (min-width: 700px) {
    .hero__tagline {
      display: inline-block;
      max-width: 100%;
      overflow: hidden;
      white-space: nowrap;
      border-right: 2px solid transparent;
      vertical-align: bottom;
    }
  }
  .hero__description {
    margin: 26px 0 0;
    max-width: 560px;
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.6;
    color: var(--muted);
  }
  .hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 34px;
    font-size: 13px;
  }
  .hero__cta {
    padding: 15px 26px;
    border-radius: 2px;
    display: inline-block;
  }
  .hero__cta--primary {
    background: var(--accent);
    color: var(--onAccent);
  }
  .hero__cta--secondary {
    border: 1px solid var(--line);
    color: var(--ink);
  }

  [data-hero-in] {
    opacity: 0;
    transform: translateY(16px);
    animation: hero-in .7s cubic-bezier(.2,.7,.3,1) forwards;
  }
  .hero > .hero__grid > div > [data-hero-in]:nth-child(1),
  .hero__badge { animation-delay: 0ms; }
  .hero h1[data-hero-in] { animation-delay: 90ms; }
  .hero__description[data-hero-in] { animation-delay: 270ms; }
  .hero__ctas[data-hero-in] { animation-delay: 360ms; }

  .hero__tagline[data-hero-in] { animation-delay: 180ms; }

  /* Above the "enough room" breakpoint, the tagline gets a typewriter
     reveal + blinking caret on top of its fade-in. `steps()` is a fixed
     count rather than matching the exact character count per locale —
     close enough to read as "typing" without needing a per-instance value
     (which would require an inline style, blocked by our CSP). */
  @media (min-width: 700px) {
    .hero__tagline[data-hero-in] {
      animation:
        hero-in .7s cubic-bezier(.2, .7, .3, 1) forwards 180ms,
        hero-tagline-type 1.6s steps(60, end) both 950ms,
        hero-tagline-caret .8s step-end 5 950ms;
    }
  }
  /* Animates max-width, not width: a percentage width is relative to the
     container, so once the (shorter) text's natural size is reached the
     element just stops growing on its own — no risk of the reveal
     finishing "still clipped" because 100% happened to be wider or
     narrower than the actual string for a given locale. */
  @keyframes hero-tagline-type {
    from { max-width: 0; }
    to { max-width: 100%; }
  }
  @keyframes hero-tagline-caret {
    0%, 100% { border-color: transparent; }
    50% { border-color: var(--accent); }
  }

  @keyframes hero-in {
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-hero-in] {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .hero__tagline[data-hero-in] {
      animation: none;
      width: auto;
      border-right-color: transparent;
    }
  }
</style>

<script>
  // Randomly reassigns which glow gets which position/motion variant on
  // each page load. Only classList is touched — never the style attribute.
  document.querySelectorAll<HTMLElement>('[data-hero-glows]').forEach((hero) => {
    const variants = ['a', 'b', 'c'];
    for (let i = variants.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [variants[i], variants[j]] = [variants[j], variants[i]];
    }
    const glows = Array.from(hero.querySelectorAll<HTMLElement>('.hero__glow'));
    glows.forEach((glow, i) => {
      glow.classList.remove('hero__glow--a', 'hero__glow--b', 'hero__glow--c');
      glow.classList.add(`hero__glow--${variants[i % variants.length]}`);
    });
  });
</script>
