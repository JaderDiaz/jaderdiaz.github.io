---
import type { SiteContent } from '../../i18n/content';
import SectionHeading from '../ui/SectionHeading.astro';
import TestimonialItem from '../ui/TestimonialItem.astro';
import AboutBlock from './AboutBlock.astro';
import TechFieldBackground from '../ui/TechFieldBackground.astro';

interface Props {
  about: SiteContent['about'];
  testimonials: SiteContent['testimonials'];
}
const { about, testimonials } = Astro.props;
---

<section id="sobre-mi" class="section about-section">
  <TechFieldBackground />
  <div class="wrap about-testimonials">
    <AboutBlock about={about} />
    <div>
      <div class="about-testimonials__testimonials-header">
        <SectionHeading eyebrow={testimonials.eyebrow} class="about-testimonials__eyebrow" />
        <span class="about-testimonials__pending mono">{testimonials.pending}</span>
      </div>
      <div class="about-testimonials__list">
        {testimonials.items.length > 0 ? (
          testimonials.items.map((t, i) => (
            <TestimonialItem quote={t.quote} attribution={t.attribution} emphasized={i === 0} />
          ))
        ) : (
          <p class="about-testimonials__placeholder mono">{testimonials.comingSoon}</p>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    overflow: hidden;
  }
  .about-testimonials {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(32px, 5vw, 64px);
  }
  .about-testimonials__testimonials-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 26px;
  }
  .about-testimonials__eyebrow {
    margin-bottom: 0;
  }
  .about-testimonials__pending {
    font-size: 11px;
    color: var(--faint);
  }
  .about-testimonials__list {
    display: grid;
    gap: 16px;
  }
  .about-testimonials__placeholder {
    border: 1px dashed var(--line);
    border-radius: 2px;
    padding: 20px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--faint);
  }
</style>
