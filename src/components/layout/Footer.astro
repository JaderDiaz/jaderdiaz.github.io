---
import { BUILD_NUMBER } from '../../version';

interface Props {
  copyright: string;
  madeWithPrefix: string;
  madeWithSuffix: string;
  versionLabel: string;
}
const { copyright, madeWithPrefix, madeWithSuffix, versionLabel } = Astro.props;

// Build-time version: the site's own "release date" plus a manually
// incremented build number (see src/version.ts) so multiple same-day
// deploys are still distinguishable.
const buildDate = new Date();
const versionDate = buildDate.toISOString().slice(0, 10).replace(/-/g, '.');
const version = `${versionDate}.${BUILD_NUMBER}`;
---

<div class="site-footer mono" data-site-footer>
  <span class="site-footer__scan-dot site-footer__scan-dot--1" aria-hidden="true"></span>
  <span class="site-footer__scan-dot site-footer__scan-dot--2" aria-hidden="true"></span>
  <span class="site-footer__made">
    <span>{copyright}</span>
    <span class="site-footer__sep" aria-hidden="true">·</span>
    <span>
      {madeWithPrefix}
      <span class="site-footer__heart" aria-hidden="true">❤</span>
      {madeWithSuffix}
    </span>
  </span>
  <span class="site-footer__version" title={`${versionLabel} ${version}`}>
    <span class="site-footer__version-dot" aria-hidden="true"></span>
    {versionLabel} {version}
  </span>
</div>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    max-width: 1400px;
    margin: 56px auto 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding: 24px 16px 20px;
    border-top: 1px solid rgba(242, 243, 241, .15);
    font-size: 11px;
    color: rgba(242, 243, 241, .5);
    /* No background texture of its own — it sits inside .contact-section,
       which already provides the dot-grid fill for the whole section.
       Adding a second one here just doubled up and looked noisy. */
  }
  /* A thin "signal" sweeping along the top border, plus a couple of
     faintly pulsing dots — the footer's own small piece of motion,
     scaled to fit a strip this thin rather than reusing the bigger
     per-section background treatments. */
  .site-footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    height: 1px;
    width: 160px;
    background: linear-gradient(90deg, transparent, #7FA6D9, transparent);
    animation: site-footer-scan 7s linear infinite;
  }
  @keyframes site-footer-scan {
    from { transform: translateX(-160px); }
    to { transform: translateX(calc(100% + 160px)); }
  }
  .site-footer__scan-dot {
    position: absolute;
    top: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #7FA6D9;
    animation: site-footer-dot-pulse 4s ease-in-out infinite;
  }
  .site-footer__scan-dot--1 { left: 14%; animation-delay: -1.2s; }
  .site-footer__scan-dot--2 { left: 40%; animation-delay: -2.6s; }
  .site-footer__scan-dot--3 { left: 62%; animation-delay: -0.4s; }
  .site-footer__scan-dot--4 { left: 84%; animation-delay: -3.1s; }
  @keyframes site-footer-dot-pulse {
    0%, 100% { opacity: 0.12; transform: scale(1); }
    50% { opacity: 0.75; transform: scale(1.9); }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-footer::before,
    .site-footer__scan-dot {
      animation: none;
    }
  }
  .site-footer__made {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .site-footer__sep {
    opacity: .5;
  }
  .site-footer__heart {
    display: inline-block;
    color: #ff5470;
    padding: 0 4px;
    transform-origin: center;
    animation: heartbeat 1.8s ease-in-out infinite;
  }
  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    15% { transform: scale(1.35); }
    30% { transform: scale(1); }
    45% { transform: scale(1.2); }
    60% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-footer__heart { animation: none; }
  }
  .site-footer__version {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 10px;
    border: 1px solid rgba(242, 243, 241, .18);
    border-radius: 2px;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-size: 10px;
    white-space: nowrap;
  }
  .site-footer__version-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #7FA6D9;
    box-shadow: 0 0 0 3px rgba(127, 166, 217, .18);
  }
</style>

<script>
  // Randomly reassigns the two pulsing dots to 2 of 4 possible positions
  // on each page load. Only classList is touched — never the style attribute.
  document.querySelectorAll<HTMLElement>('[data-site-footer]').forEach((footer) => {
    const pool = [1, 2, 3, 4];
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    const dots = Array.from(footer.querySelectorAll<HTMLElement>('.site-footer__scan-dot'));
    dots.forEach((dot, i) => {
      dot.classList.remove(
        'site-footer__scan-dot--1',
        'site-footer__scan-dot--2',
        'site-footer__scan-dot--3',
        'site-footer__scan-dot--4',
      );
      dot.classList.add(`site-footer__scan-dot--${pool[i % pool.length]}`);
    });
  });
</script>
