---
interface Props {
  lightLabel: string;
  darkLabel: string;
}
const { lightLabel, darkLabel } = Astro.props;
---

<button
  type="button"
  data-theme-btn
  data-light-label={lightLabel}
  data-dark-label={darkLabel}
  class="theme-toggle mono"
>{lightLabel}</button>

<style>
  .theme-toggle {
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: transparent;
    color: var(--faint);
    font-size: 12px;
  }
</style>

<script>
  const STORAGE_KEY = 'theme';
  const root = document.documentElement;

  function applyTheme(mode: string) {
    root.dataset.theme = mode;
    try {
      localStorage.setItem(STORAGE_KEY, mode);
    } catch {
      /* localStorage unavailable (private mode, etc.) — theme just won't persist */
    }
    document.querySelectorAll<HTMLButtonElement>('[data-theme-btn]').forEach((btn) => {
      const isDark = mode === 'dark';
      btn.textContent = isDark ? btn.dataset.darkLabel ?? 'light' : btn.dataset.lightLabel ?? 'dark';
    });
  }

  // Restore persisted preference (default: light, no system-preference override).
  let saved = 'light';
  try {
    saved = localStorage.getItem(STORAGE_KEY) ?? 'light';
  } catch {
    /* ignore */
  }
  applyTheme(saved);

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-theme-btn]');
    if (!btn) return;
    applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
  });
</script>
